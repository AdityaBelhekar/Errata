.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Content-addressed blob store: documents are fetched, never committed (FR-9.5)
var/
blobs/
*.pdf
!bench/fixtures/**/*.manifest.json

# Local run output
out/
*.local.yaml
.env

# Node / frontend
node_modules/
.DS_Store


# Playwright run artifacts. The SNAPSHOT baselines under e2e/*-snapshots/ are
# committed on purpose -- they are the reference the diff runs against. These are
# the per-run outputs and reports, which are regenerated every run.
test-results/
playwright-report/
blob-report/
.playwright/

# Vercel build output, assembled by scripts/build_static.py from web/ -- generated, never source.
public/
