{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web/app && npm ci --no-audit --no-fund && npm run build && cd ../.. && python3 scripts/build_static.py",
  "outputDirectory": "public",
  "installCommand": "echo 'install runs inside buildCommand (web/app is not the repo root)'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/web/console",
      "destination": "https://token-wasters-errata.onrender.com/"
    },
    {
      "source": "/web/console/:path*",
      "destination": "https://token-wasters-errata.onrender.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/web/:tree(landing|site|datum)/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
